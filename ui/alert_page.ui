  <property name="styleSheet">
   <string notr="true">
    QWidget { background-color: #0f172a; color: #f8fafc; }
    
    /* Titre Alerte */
    QLabel#lbl_title { 
        font-size: 24px; 
        font-weight: bold; 
        color: #ef4444; 
    }
    
    /* Bouton Rafraîchir */
    QPushButton#btn_refresh { 
        background-color: #3b82f6; 
        color: white; 
        border-radius: 8px; 
        font-weight: bold; 
        padding: 0 15px;
    }
    QPushButton#btn_refresh:hover { background-color: #2563eb; }

    /* Frame de filtrage */
    QFrame#filter_frame { 
        background-color: #1e293b; 
        border: 1px solid #334155;
        border-radius: 12px; 
    }
    
    QComboBox {
        background-color: #0f172a;
        border: 1px solid #475569;
        border-radius: 6px;
        padding: 5px;
        color: white;
    }

    /* Table des Alertes */
    QTableWidget { 
        background-color: #111827; 
        border: 1px solid #1e293b; 
        gridline-color: #1e293b; 
        border-radius: 10px; 
        selection-background-color: #450a0a; /* Rouge très sombre pour la sélection */
    }
    QHeaderView::section { 
        background-color: #1e293b; 
        color: #94a3b8; 
        padding: 12px; 
        font-weight: bold; 
        border: none;
        border-bottom: 2px solid #ef4444; /* Ligne rouge sous le header pour l'aspect alerte */
    }
   </string>
